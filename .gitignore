# Godot import cache — regenerated on each machine
godot/.godot/

# Voice service: virtualenv (created by ./setup-voice) and model downloads
.voice-venv/
voice/models/
voice/__pycache__/
**/__pycache__/
*.pyc

# Development backups and check logs
backups/
previews/**/*.log

# Test audio recordings generated by audio checks
previews/*.wav

# Old base-project files — see the parent repo and README «Исходная документация»
source/
scripts/
research/
blender/*.blend
PROJECT_REQUIREMENTS.txt

# Misc
*.blend[0-9]
*.bak
.DS_Store
.env
.env.*
